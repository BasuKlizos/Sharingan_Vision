# ========================
# APP CONFIG
# ========================
APP_ENV=development
PORT=8000


# ========================
# REDIS CONFIG
# ========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
REDIS_PASSWORD=password

# ========================
#  PERFORMANCE / FUTURE
# ========================
REDIS_DB=0
REDIS_TIMEOUT=5

# ========================
# MONGODB CONFIG
# ========================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sharingan_vision

# ========================
# PROCTORING CONFIGURATION
# ========================
# Proctoring data persistence backend: 
#   - "redis" (fast, cache only - data lost on restart)
#   - "mongo" (persistent DB only)
#   - "dual" (RECOMMENDED - saves to both Redis cache + MongoDB for persistence)
PROCTOR_STORE_BACKEND=dual

# Background flush interval (seconds) - how often to flush Redis data to MongoDB
PROCTOR_FLUSH_INTERVAL_SECONDS=30